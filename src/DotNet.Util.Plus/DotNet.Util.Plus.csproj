<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="Current">

	<PropertyGroup>
		<TargetFrameworks>net462;net47;net48;net6.0;net8.0;net10.0;netstandard2.0;netstandard2.1</TargetFrameworks>
		<Description>A set of .NET 10/8/6/Standard 2.1/Standard 2.0 utilities(support .net framework 4.62/4.7/4.8). Please visit https://github.com/cuiwenyuan/DotNet.Util for more information</Description>
		<Company>www.cuiwenyuan.cn</Company>
		<Copyright>©2008-2026 Wangcaisoft</Copyright>
		<Authors>崔文远Troy Cui</Authors>
		<PackageReleaseNotes>Please visit https://github.com/cuiwenyuan/DotNet.Util for details</PackageReleaseNotes>
		<PackageTags>DotNet Util Utilities</PackageTags>
		<PackageProjectUrl>https://github.com/cuiwenyuan/DotNet.Util/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/cuiwenyuan/DotNet.Util/</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageId>Wangcaisoft.DotNet.Util.Plus</PackageId>
		<PackageIcon>logo.128.png</PackageIcon>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<AssemblyName>DotNet.Util.Plus</AssemblyName>
		<RootNamespace>DotNet.Util</RootNamespace>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<ApplicationIcon>App.ico</ApplicationIcon>
		<RepositoryType>git</RepositoryType>
		<VersionPrefix>1.2</VersionPrefix>
		<VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
		<Version>$(VersionPrefix).$(VersionSuffix)</Version>
		<FileVersion>$(Version)</FileVersion>
		<AssemblyVersion>$(VersionPrefix).$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</AssemblyVersion>
		<LangVersion>latest</LangVersion>
		<DisableImplicitNamespaceImports>true</DisableImplicitNamespaceImports>
		<PackageReadmeFile>README.md</PackageReadmeFile>
</PropertyGroup>

	<ItemGroup>
		<None Include="logo.128.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1'">
		<!--NPOI 2.8.0 起改为 OSMF EULA 商业许可，保持 Apache-2.0 免费版最高 2.7.6-->
		<PackageReference Include="NPOI" Version="2.7.6" />
		<PackageReference Include="System.DirectoryServices" Version="10.0.11" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="NPOI" Version="2.7.6" />
		<!--DirectoryServices 9.x/10.x 不再支持 net6.0（会报 "doesn't support net6.0"），8.0.0 是 net6.0 兼容的最高版-->
		<PackageReference Include="System.DirectoryServices" Version="8.0.0" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="NPOI" Version="2.7.6" />
		<PackageReference Include="System.DirectoryServices" Version="10.0.11" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='net462' or '$(TargetFramework)'=='net47' or '$(TargetFramework)'=='net472' or '$(TargetFramework)'=='net48'">
		<Reference Include="System.Net.Http" />
		<Reference Include="System.DirectoryServices" />
		<Reference Include="System.Web" />
		<Reference Include="System.Windows.Forms" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='net462' or '$(TargetFramework)'=='net47'">
		<PackageReference Include="NPOI" Version="2.5.6" />
		<PackageReference Include="SharpZipLib" Version="1.3.3" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='net472' or '$(TargetFramework)'=='net48'">
		<!--NPOI 2.7.6 的 net472 资产缺少 SetUnderline/CellType.Unknown 等 API（与 ns2.0/net8.0 资产不一致），故 net472/net48 保持 2.5.6-->
		<PackageReference Include="NPOI" Version="2.5.6" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
	</ItemGroup>

	<!-- XmlUtil.cs/PathProvider.cs 使用 PhysicalFileProvider/IHostEnvironment/IHostingEnvironment，
		 原为 DotNet.Util 传递依赖，现 DotNet.Util 已移除 Extensions 包，故在此直接引用。
		 版本与 DotNet.Util 的 Extensions 版本保持一致：net6.0 用 8.0.1，其余用 10.0.11。 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
		<!--FileProviders.Physical 无 8.0.1，8.0.0 已是 net6.0 兼容的最高版（9.x 起不再支持 net6.0）-->
		<PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="8.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0' or '$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DotNet.Util\DotNet.Util.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
