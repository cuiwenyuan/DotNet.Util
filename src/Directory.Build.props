<Project>
  <!-- 统一抑制 CS1591（公开类型/成员缺 XML 注释）。
       本库开启 GenerateDocumentationFile 但并未为全部公开 API 补 /// 文档，
       CS1591 仅影响 IntelliSense 文档完整性、不影响编译正确性，按惯例抑制为警告噪音。
       若希望驱动补文档，可删除本文件或移除 1591。 -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- CI（windows-latest 只装 .NET 10 SDK、无 VS）缺 .NET Framework 4.6.0 参考程序集
       （runner 仅带 4.6.2+），导致 net46 目标无法编译、打包报“DLL not found”。
       引入官方参考程序集包，让 net46/47/48 在无 VS 环境也能构建；
       本地有 VS 参考程序集时不冲突（解析到同一程序集）。
       注意：必须带 PrivateAssets="all"——该包仅供构建期解析参考程序集，
       否则会被写进 nuspec 的 net4x 依赖分组，导致消费者被传递拉入整包引用程序集。 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net46' or '$(TargetFramework)' == 'net47' or '$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
